{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies",
    "autoapprove",
    "{{datasource}}"
  ],
  "rebaseWhen": "conflicted",
  "branchNameStrict": true,
  "assigneesFromCodeOwners": true,
  "prConcurrentLimit": 1,
  "minimumReleaseAge": "3 days"
}
