{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies",
    "autoapprove",
    "{{datasource}}"
  ],
  "rebaseWhen": "conflicted",
  "branchNameStrict": true,
  "assigneesFromCodeOwners": true,
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "groupName": "OpenTelemetry Java",
      "matchPackageNames": [
        "io.opentelemetry:**"
      ]
    }
  ]
}
